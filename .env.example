# API Keys
GEMINI_API_KEY=your_actual_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# One provider and model for answers and intent classification. No automatic fallback.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
OPENAI_MODEL=
ANTHROPIC_MODEL=
DEEPSEEK_MODEL=
GROQ_MODEL=
MISTRAL_MODEL=
XAI_MODEL=
OPENROUTER_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codesage

# Services
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Embeddings: gemini | voyage | unixcoder | local | openai | openai_compatible
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-2
EMBED_BATCH_SIZE=32
# Optional requested dimension; omit to use/detect the model's native dimension.
# EMBED_DIMENSIONS=768
# EMBED_API_KEY overrides the provider-specific key for this role.
# EMBED_API_KEY=
# EMBED_BASE_URL=http://localhost:8001/v1
# EMBED_REVISION=checkpoint-revision-or-deployment-version
# EMBED_QUERY_PREFIX=
# EMBED_DOCUMENT_PREFIX=
# Task types are optional/model-specific; embedding-2 does not use task_type.
# EMBED_QUERY_TASK=CODE_RETRIEVAL_QUERY
# EMBED_DOCUMENT_TASK=RETRIEVAL_DOCUMENT
# Local model configuration is JSON. Local dependencies are installed separately.
# EMBED_LOCAL_MODEL_OPTIONS={"device":"cpu"}
# EMBED_LOCAL_ENCODE_OPTIONS={}
# EMBED_LOCAL_MAX_LENGTH=512
# EMBEDDING_CACHE_PATH=.embedding_cache
# EMBEDDING_SOURCE_MAX_CHARS=8000
# EMBEDDING_GRAPH_NEIGHBORS=5
# EMBEDDING_REPRESENTATION_VERSION=1

# Reranking: gemini | voyage | cohere | local | http | none
RERANK_PROVIDER=gemini
RERANK_MODEL=gemini-3.8-flash
RERANK_BATCH_SIZE=16
RERANK_TOP_K=20
RERANK_MAX_CANDIDATES=100
# RERANK_API_KEY=
# RERANK_BASE_URL=http://localhost:8002/v1
# RERANK_REVISION=checkpoint-revision
# RERANK_DOCUMENT_MAX_CHARS=8000
# RERANK_MAX_OUTPUT_TOKENS=4096
# RERANK_LOCAL_MODEL_OPTIONS={"device":"cpu"}
# RERANK_LOCAL_PREDICT_OPTIONS={}

# Provider keys, used only when that provider is selected.
VOYAGE_API_KEY=
COHERE_API_KEY=
# Endpoints may point to cloud services, a gateway, or a local server.
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
# COHERE_BASE_URL=https://api.cohere.com/v2
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
RETRIEVAL_MODEL_TIMEOUT_SECONDS=60
RETRIEVAL_MODEL_ATTEMPTS=3
RETRIEVAL_MODEL_RETRY_DELAY_SECONDS=1
QDRANT_COLLECTION=codesage

# App
APP_NAME=CodeSage
DEBUG=True

REPO_PATH=

# Optional LangSmith tracing (questions and retrieved code are sent to LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codesage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
