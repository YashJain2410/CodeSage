# Same-origin proxy avoids modifying the backend's CORS configuration.
CODESAGE_BACKEND_URL=http://127.0.0.1:8000
# Leave unset to use /api/backend. Set only for direct browser API access.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
# current = inspected backend contracts; planned = contracts in API-CONTRACT.md
NEXT_PUBLIC_API_MODE=current
