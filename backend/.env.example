# API Keys
GEMINI_API_KEY=your_actual_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# One provider and model for answers and intent classification. No automatic fallback.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
OPENAI_MODEL=
ANTHROPIC_MODEL=
DEEPSEEK_MODEL=
GROQ_MODEL=
MISTRAL_MODEL=
XAI_MODEL=
OPENROUTER_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codesage

# Services
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Embedding
EMBED_MODEL=microsoft/unixcoder-base
EMBED_BATCH_SIZE=32

# App
APP_NAME=CodeSage
DEBUG=True

REPO_PATH=

# Optional LangSmith tracing (questions and retrieved code are sent to LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codesage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
